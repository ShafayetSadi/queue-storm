# QueueStorm Investigator — environment variables.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Service ---
PORT=8000
# Set true ONLY in private/dev deployments; keeps PII out of logs by default.
LOG_COMPLAINT_TEXT=false

# --- LLM (OpenRouter, OpenAI-compatible) ---
# The service runs fully without these (deterministic fallback). To use the LLM
# (recommended, ON by default), provide an OpenRouter API key.
USE_LLM=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model id available on OpenRouter; swap freely without code changes.
MODEL_NAME=anthropic/claude-haiku-4.5
LLM_TIMEOUT_SECONDS=5
LLM_MAX_RETRIES=1

# Optional OpenRouter attribution headers.
OPENROUTER_REFERER=https://github.com/queuestorm-investigator
OPENROUTER_TITLE=QueueStorm Investigator
